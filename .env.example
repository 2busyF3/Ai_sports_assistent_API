# Use a strong unique value in a real cloud deployment.
POSTGRES_PASSWORD=change-this-before-deploying
# Optional: improves free-form workout extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional separate model for coaching; defaults to OPENAI_MODEL.
OPENAI_COACH_MODEL=gpt-4o-mini
# Comma-separated browser origins in production, for example https://app.example.com
CORS_ORIGINS=*
# true creates the visual walkthrough data on a fresh database.
SEED_DEMO_DATA=true
